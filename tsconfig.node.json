{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // src/lib/tvtime.ts is shared: the API imports its grouping helper so the
  // browser and the server cannot disagree about what one show is.
  "include": ["vite.config.ts", "vitest.config.ts", "api/**/*.ts", "src/lib/tvtime.ts"]
}
