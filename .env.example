# Copy to .env.local and fill in. Never commit real values.
#
# Supabase renamed its key pair: `anon` -> publishable, `service_role` ->
# secret. Prefer the new names below; the legacy variable names are still
# accepted by api/_lib.ts so an older deploy keeps working.

# --- Client (safe to expose; ships in the browser bundle, RLS protects data) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sb_publishable_... from Settings -> API Keys>

# --- Server only (Vercel env vars; NEVER prefixed VITE_) ---
TMDB_API_KEY=<TMDB v3 api key>
SUPABASE_URL=https://<project-ref>.supabase.co
# Same publishable key as above; lets the API act as the caller under RLS.
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Bypasses RLS entirely. Server only — a leak exposes every row.
SUPABASE_SECRET_KEY=<sb_secret_... from Settings -> API Keys>
CRON_SECRET=<random string; Vercel sends it as Authorization: Bearer for crons>
